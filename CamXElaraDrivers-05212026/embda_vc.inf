;---------------------  C O M M O N  ----------------------
[InstFilter28xx]
HKR,,"LowerFilters",0x00010000,"USB28xxOEM"

[InstFilter2860ix]
HKR,,"LowerFilters",0x00010000,"USB28xxOEM"
;LibUsb Filter
HKR,,"UpperFilters",0x00010000,"libusb0"
HKR,,"SymbolicName",,"\??\USB#VID_131E&PID_0103#2108-120-50#{a5dcbf10-6530-11d2-901f-00c04fb951ed}" ;This is a fix for USB 3.0 this entry is sometimes missing

[InstFilter28xxe]
HKR,,"LowerFilters",0x00010000,"USB28xxOEM"
;LibUsb Filter
HKR,,"UpperFilters",0x00010000,"libusb0"
HKR,,"SymbolicName",,"\??\USB#VID_131E&PID_0107#2108120055#{a5dcbf10-6530-11d2-901f-00c04fb951ed}" ;This is a fix for USB 3.0 this entry is sometimes missing

[InstFilter28xxs]
HKR,,"LowerFilters",0x00010000,"USB28xxOEM"
;LibUsb Filter
HKR,,"UpperFilters",0x00010000,"libusb0"
HKR,,"SymbolicName",,"\??\USB#VID_131E&PID_0108#2108120056#{a5dcbf10-6530-11d2-901f-00c04fb951ed}" ;This is a fix for USB 3.0 this entry is sometimes missing


[TVTuner]
AddReg        = TVTuner_AddReg

[TVTuner_AddReg]
HKR, , CLSID, , %ProxyTVTuner.CLSID%
HKR, , FriendlyName, , %TVTuner.Name%


