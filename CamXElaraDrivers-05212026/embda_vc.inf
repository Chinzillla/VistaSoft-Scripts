AddReg        = TVAudio_AddReg

[TVAudio_AddReg]
HKR, , CLSID, , %ProxyTVAudio.CLSID%
HKR, , FriendlyName, , %TVAudio.Name%


[Xbar]
AddReg        = Xbar_AddReg

[Xbar_AddReg]
HKR, , CLSID, , %ProxyXbar.CLSID%
HKR, , FriendlyName, , %Xbar.Name%


[InstallFilter_G5100]
HKR, , "LowerFilters", 0x00010000, "USB28xxOEM"
;LibUsb Filter
HKR,,"UpperFilters",0x00010000,"libusb0"
;HKR,,"SymbolicName",,"\??\USB#VID_0FE2&PID_0220#{a5dcbf10-6530-11d2-901f-00c04fb951ed}" ;This is a fix for USB 3.0 this entry is sometimes missing


[InstallFilter_G4100]
