;---------------------  LibUSB ---------------------------
[UTL.LibUSB]
libusb0.dll

[UTL.LibUSBSys]
libusb0.sys

[UTL.LibUSB64]
libusb0.dll

[UTL.LibUSBSys64]
libusb0.sys

;-------------------------  O E M  ------------------------

[OEM.DelReg]
HKR,settings\OEMSettings

[OEM.AddReg]
; Board Configurations
HKR,settings\OEMSettings,Optimization,0x00010001,1      ; 1=ISO, 2=Bulk
HKR,settings\OEMSettings,FixUpOWC,0x00010001,12
HKR,settings\OEMSettings,FixUpATI,0x00010001,0          ; 1=enabled for multiple root hubs
HKR,settings\OEMSettings,EnablePAL640x576,0x00010001,0  ; For 2820/2840
HKR,settings\OEMSettings,XceiveMTS,0x00010001,0         ; XC3028 Baseband Audio
HKR,settings\OEMSettings,EnableHDInputPins,0x00010001,1	; Enable those input pins of capture filter for HDMI/720P/1080i
HKR,settings\OEMSettings,DRXJIFLevelThreshold,0x00010001,0
HKR,settings\OEMSettings,QT1010LNA,0x00010001,0         ; 1=enabled
HKR,settings\OEMSettings,QT1010V3,0x00010001,1          ; 0/1/2/3
HKR,settings\OEMSettings,AMDEMOD,0x00010001,2           ; 2=GPIO2, 6=GPIO6
HKR,settings\OEMSettings,ATSCMode,0x00010001,0          ; 0=VSB8, 1=QAM64, 2=QAM256
HKR,settings\OEMSettings,IsMCE,0x00010001,2             ; 1=MCE, 0=non-MCE,
HKR,settings\OEMSettings,LNBDCBoost,0x00010001,0        ;0=13/18v, 1=14/19v
HKR,settings\OEMSettings,NXPEnableADVAuto,0x00010001,0  ;0=Disable, 1=Enable
HKR,settings\OEMSettings,NXPEnableDVBSAuto,0x00010001,0 ;0=Disable, 1=Enable
HKR,settings\OEMSettings,NXPAcqAttemptS,0x00010001,1 
HKR,settings\OEMSettings,NXPAcqAttemptS2,0x00010001,1
HKR,settings\OEMSettings,NXPAcqTimeoutS,0x00010001,120
HKR,settings\OEMSettings,NXPAcqTimeoutS2,0x00010001,180
HKR,settings\OEMSettings,NXPDiseqTimeGap,0x00010001,15
HKR,settings\OEMSettings,NXPInitRetry,0x00010001,1
HKR,settings\OEMSettings,NXPFWCheck,0x00010001,1
HKR,settings\OEMSettings,NXPIgnoreFWCRCCheck,0x00010001,0
