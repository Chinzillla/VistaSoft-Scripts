
;------------------------------------------------------------------
;
;   emBDA_x86_x64.inf -- This file contains installation information for
;                        eMPIA USB 2.0 Video Devices EM28xx.
;
;   This installation is for Windows XP, Vista, 7, and 8 (x86/x64).
;
;   Copyright (C) eMPIA Technology Corp.  2002-2013
;
;------------------------------------------------------------------

[Version]
signature         = "$CHICAGO$"
Class             = Media
ClassGUID         = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider          = %Vendor%
DriverPackageType = PlugAndPlay
CatalogFile       = emvc.cat
DriverVer         = 04/06/2020, 5.2020.0406.0

[ControlFlags]
ExcludeFromSelect = *

[SourceDisksNames]
1 = %DiskLabel%,"",

[SourceDisksFiles]
emPRP.ax    = 1,i386
emOEM.sys   = 1,i386
emBDA.sys   = 1,i386
emPRP64.ax  = 1,amd64
emOEM64.sys = 1,amd64
emBDA64.sys = 1,amd64
emMON.exe   = 1
merlinFW.rom= 1
emDLL.dll   = 1
libusb0.sys = 1,i386
libusb0.dll = 1,i386

[SourceDisksFiles.amd64]
emPRP.ax    = 1,i386
emPRP64.ax  = 1,amd64
emOEM64.sys = 1,amd64
emBDA64.sys = 1,amd64
emMON.exe   = 1
merlinFW.rom = 1
libusb0.sys = 1,amd64
libusb0.dll = 1,amd64

[DestinationDirs]
DefaultDestDir = 11
CAP.CopyDLLx86 = 10,system32
CAP.CopyDLLx64 = 10,system32
CAP.CopyDLLwow64 = 10,syswow64
CAP.CopySYSx86 = 10,system32\drivers
CAP.CopySYSx64 = 10,system32\drivers
UTL.CopyList   = 10
UTL.LibUSB     = 10,syswow64
UTL.LibUSBSys  = 10,syswow64\drivers
UTL.LibUSB64   = 10,system32
UTL.LibUSBSys64 = 10,system32\drivers

BDADriver_Copy_x86 = 10, system32\drivers
Empia_Copy_x86     = 11
Polaris_Copy_x86   = 11
Spectra_Copy_x86   = 11
BDADriver_Copy_x64 = 10, system32\drivers
Empia_Copy_x64     = 11
Polaris_Copy_WOW   = 10, syswow64
Spectra_Copy_WOW   = 10, syswow64

[Manufacturer]
%Vendor% = Models,NTx86,NTamd64


[Models.NTamd64]
%USB2800.DeviceDesc% = USB2800,USB\VID_EB1A&PID_2800
%USB2820.DeviceDesc% = USB2820,USB\VID_EB1A&PID_2820
%USB2860.DeviceDesc% = USB2860,USB\VID_EB1A&PID_2860
%USB2860ix.DeviceDesc% = USB2860ix,USB\VID_131E&PID_0103
%USB2860e.DeviceDesc% = USB2860e,USB\VID_131E&PID_0107
%USB2860s.DeviceDesc% = USB2860s,USB\VID_131E&PID_0108
%G5100.DeviceDesc%    = G5100,     USB\VID_0FE2&PID_0220
%G4100.DeviceDesc%    = G4100,     USB\VID_0FE2&PID_0302

[Models.NTx86]
%USB2800.DeviceDesc% = USB2800,USB\VID_EB1A&PID_2800
%USB2820.DeviceDesc% = USB2820,USB\VID_EB1A&PID_2820
%USB2860.DeviceDesc% = USB2860,USB\VID_EB1A&PID_2860
%USB2860ix.DeviceDesc% = USB2860ix,USB\VID_131E&PID_0103
%USB2860e.DeviceDesc% = USB2860e,USB\VID_131E&PID_0107
%USB2860s.DeviceDesc% = USB2860s,USB\VID_131E&PID_0108
%G5100.DeviceDesc%    = G5100,     USB\VID_0FE2&PID_0220
%G4100.DeviceDesc%    = G4100,     USB\VID_0FE2&PID_0302

;---------------------  U S B 2 8 0 0  --------------------

[USB2800.NTx86]
Include       = ks.inf, kscaptur.inf, ksfilter.inf, bda.inf
Needs         = KS.Registration, KSCAPTUR.Registration.NT, BDA.Installation.NT
DelReg	      = OEM.DelReg, UTL.DelReg
AddReg        = CAP.AddRegx86, OEM.AddReg, OEM.AddReg.DD, OEM.AddReg2800, OEM.Defaults.AddReg, UTL.AddReg
CopyFiles     = CAP.CopySYSx86, CAP.CopyDLLx86, UTL.CopyList

[USB2800.NTx86.HW]
AddReg = InstFilter28xx


[USB2800.NTamd64]
Include       = ks.inf, kscaptur.inf, ksfilter.inf, bda.inf
Needs         = KS.Registration, KSCAPTUR.Registration.NT, BDA.Installation.NT
DelReg	      = OEM.DelReg, UTL.DelReg
AddReg        = CAP.AddRegx64, OEM.AddReg, OEM.AddReg.DD, OEM.AddReg2800, OEM.Defaults.AddReg, UTL.AddReg
CopyFiles     = CAP.CopySYSx64, CAP.CopyDLLx64, CAP.CopyDLLwow64, UTL.CopyList

[USB2800.NTamd64.HW]
AddReg = InstFilter28xx


;---- I N T E R F A C E S ----

[USB2800.NTx86.Interfaces]
AddInterface = %KSCATEGORY_VIDEO%,  %WDMCapFilter%,  Capture2800.Interface
AddInterface = %KSCATEGORY_CAPTURE%,%WDMCapFilter%,  Capture2800.Interface
AddInterface = %KSCATEGORY_TVTUNER%,%WDMTunerFilter%,TVTuner2800.Interface
AddInterface = %KSCATEGORY_TVAUDIO%,%WDMTVAudFilter%,TVAudio2800.Interface
AddInterface = %KSCATEGORY_XBAR%,   %WDMXbarFilter%, Xbar2800.Interface

[USB2800.NTamd64.Interfaces]
AddInterface = %KSCATEGORY_VIDEO%,  %WDMCapFilter%,  Capture2800.Interface
AddInterface = %KSCATEGORY_CAPTURE%,%WDMCapFilter%,  Capture2800.Interface
AddInterface = %KSCATEGORY_TVTUNER%,%WDMTunerFilter%,TVTuner2800.Interface
AddInterface = %KSCATEGORY_TVAUDIO%,%WDMTVAudFilter%,TVAudio2800.Interface
AddInterface = %KSCATEGORY_XBAR%,   %WDMXbarFilter%, Xbar2800.Interface


[Capture2800.Interface]
AddReg = Capture.2800.AddReg

[TVTuner2800.Interface]
AddReg = TVTuner.2800.AddReg

[TVAudio2800.Interface]
AddReg = TVAudio.2800.AddReg

[Xbar2800.Interface]
AddReg = Xbar.2800.AddReg


[Capture.2800.AddReg]
HKR,,CLSID,,%ProxyVCap.CLSID%
HKR,,FriendlyName,,%Cap.2800.Name%
; IAMVideoCompression installed as static interface on both output pins
HKR,PinFactory\0\Interfaces\{C6E13343-30AC-11d0-A18C-00A0C9118956},,,{C6E13343-30AC-11d0-A18C-00A0C9118956}
HKR,PinFactory\1\Interfaces\{C6E13343-30AC-11d0-A18C-00A0C9118956},,,{C6E13343-30AC-11d0-A18C-00A0C9118956}

[TVTuner.2800.AddReg]
HKR,,CLSID,,%ProxyTVTuner.CLSID%
HKR,,FriendlyName,,%TVTuner.2800.Name%

[TVAudio.2800.AddReg]
HKR,,CLSID,,%ProxyTVAudio.CLSID%
HKR,,FriendlyName,,%TVAudio.2800.Name%

[Xbar.2800.AddReg]
HKR,,CLSID,,%ProxyXbar.CLSID%
HKR,,FriendlyName,,%Xbar.2800.Name%




;------ S E R V I C E S ------

[USB2800.NTx86.Services]
AddService = USB28xxBGA,0x00000002,BDAInstall2800x86
AddService = USB28xxOEM,0x00000000,OEMInstall2800x86

[BDAInstall2800x86]
DisplayName   = %USB2800.DeviceDesc%
ServiceType   = 1		;SERVICE_KERNEL_DRIVER
StartType     = 3		;SERVICE_DEMAND_START
ErrorControl  = 1		;SERVICE_ERROR_NORMAL
ServiceBinary = %12%\emBDA.sys


[USB2800.NTamd64.Services]
AddService = USB28xxBGA,0x00000002,BDAInstall2800x64
AddService = USB28xxOEM,0x00000000,OEMInstall2800x64

[BDAInstall2800x64]
DisplayName   = %USB2800.DeviceDesc%
ServiceType   = 1		;SERVICE_KERNEL_DRIVER
StartType     = 3		;SERVICE_DEMAND_START
ErrorControl  = 1		;SERVICE_ERROR_NORMAL
ServiceBinary = %12%\emBDA64.sys



